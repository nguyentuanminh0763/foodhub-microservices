# === Auth Service (MySQL) ===
AUTH_DB_NAME=foodhub_auth
AUTH_DB_USER=foodhub
AUTH_DB_PASSWORD=changeme
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# === Restaurant Service (MongoDB) ===
RESTAURANT_MONGO_URI=mongodb://mongo:27017/foodhub_restaurant

# === Order Service (MySQL) ===
ORDER_DB_NAME=foodhub_order
ORDER_DB_USER=foodhub
ORDER_DB_PASSWORD=changeme

# Internal service URLs (used by Order to call Restaurant, sync REST)
RESTAURANT_SERVICE_URL=http://restaurant-service:3001
