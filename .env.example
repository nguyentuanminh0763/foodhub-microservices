# Copy to .env and adjust. .env is gitignored and holds real secrets.
# Verify compose can read it:  docker compose config

# === restaurant-service ===
RESTAURANTS_DB_NAME=foodhub_restaurants
RESTAURANTS_DB_USER=foodhub
RESTAURANTS_DB_PASSWORD=changeme

# === order-service ===
ORDERS_DB_NAME=foodhub_orders
ORDERS_DB_USER=foodhub
ORDERS_DB_PASSWORD=changeme

# === Prisma connection strings ===
# Each service gets its own DATABASE_URL and may only touch its own database.
# Inside compose, services reach Postgres on port 5432 by container name.
RESTAURANTS_DATABASE_URL=postgresql://foodhub:changeme@restaurants-db:5432/foodhub_restaurants?schema=public
ORDERS_DATABASE_URL=postgresql://foodhub:changeme@orders-db:5432/foodhub_orders?schema=public

# Running a service from your terminal instead (loop 2 in docs/RUNNING.md)?
# Use these in that service's own .env - localhost and the published port:
#   postgresql://foodhub:changeme@localhost:5433/foodhub_restaurants?schema=public
#   postgresql://foodhub:changeme@localhost:5434/foodhub_orders?schema=public

# === Internal service URLs (sync HTTP, Phase 2) ===
RESTAURANT_SERVICE_URL=http://restaurant:3001
ORDER_SERVICE_URL=http://order:3002
