# Copy to .env. Prisma CLI reads this file; .env itself is gitignored.
#
# Running from your terminal — localhost and the published port:
DATABASE_URL="postgresql://foodhub:changeme@localhost:5433/foodhub_restaurants?schema=public"
#
# Running inside compose — container name and 5432:
# DATABASE_URL="postgresql://foodhub:changeme@restaurants-db:5432/foodhub_restaurants?schema=public"
