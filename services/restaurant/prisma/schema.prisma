// restaurant-service owns restaurants, dishes, prices and stock. order-service
// must ASK for a price over HTTP; it cannot JOIN against this database.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: no `url` here. It lives in prisma.config.ts and in the adapter.
datasource db {
  provider = "postgresql"
}

model Restaurant {
  id     Int    @id @default(autoincrement())
  name   String
  dishes Dish[]

  @@map("restaurants")
}

model Dish {
  id   Int    @id @default(autoincrement())
  name String

  // VND has no subunit: an integer count of dong is exact. The unit is in the
  // name so the Int decision cannot be misread at a call site.
  priceVnd Int @map("price_vnd")

  // The column five concurrent orders fight over in Phase 5 — why Redis exists.
  stock Int @default(0)

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("dishes")
}

// An idempotent stock reservation also stores the agreed prices. Retries never
// deduct twice and never pick up a price change halfway through checkout.
model Reservation {
  id           String   @id
  restaurantId Int      @map("restaurant_id")
  request      Json
  items        Json
  released     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reservations")
}
